# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Google AI Studio API key, used for both embeddings and generation.
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional overrides. The defaults below are what the code uses if unset.
# EMBEDDING_MODEL=gemini-embedding-001
# GENERATION_MODEL=gemini-3.1-flash-lite
